+@pytest.fixture
+def mobile_api(fleet, monkeypatch):
+    source = Path(__file__).resolve().parents[1] / "dashboard" / "plugin_api.py"
+    spec = importlib.util.spec_from_file_location("mobile_target_api_fixture", source)
+    api = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(api)
+    monkeypatch.setattr(api, "TASKS", fleet.manager)
+    monkeypatch.setattr(api, "TARGETS", fleet.selection)
+    monkeypatch.setattr(api, "require_dashboard_auth", lambda request: None)
+    monkeypatch.setenv("TALK_VOICE_MODE", "native")
+    monkeypatch.setenv("TALK_VOICE", "marin")
+    monkeypatch.setenv("TALK_MODEL", "gpt-realtime-2.1")
+    monkeypatch.setenv("TALK_PREFER_CODEX_OAUTH", "true")
+    monkeypatch.setenv("TALK_OPENAI_API_KEY", "sk-mobile-must-not-be-used")
+    monkeypatch.setattr(
+        api.talk_auth, "_resolve_codex_oauth",
+        lambda home: SimpleNamespace(token="fixture-codex-secret", source="codex-oauth"),
+    )
+    body = {"task": {"target_id": target(fleet), "tab_id": "mobile-tab"}}
+
+    async def read():
+        return body
+
+    fleet.request.json = read
+    return api, body
+
+
+@pytest.mark.parametrize(
+    "setting,value",
+    [
+        ("TALK_VOICE_MODE", "cascade"),
+        ("TALK_VOICE_MODE", "live"),
+        ("TALK_MODEL", "gpt-realtime"),
+        ("TALK_PREFER_CODEX_OAUTH", None),
+        ("TALK_PREFER_CODEX_OAUTH", "false"),
+        ("TALK_PREFER_CODEX_OAUTH", "invalid"),
+    ],
+)
+def test_mobile_refuses_wrong_lane_before_target_or_mint(
+    fleet, mobile_api, monkeypatch, setting, value
+):
+    api, _ = mobile_api
+    if value is None:
+        monkeypatch.delenv(setting, raising=False)
+    else:
+        monkeypatch.setenv(setting, value)
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("Mobile refusal must precede target preparation, activation and mint")
+
+    monkeypatch.setattr(fleet.selection, "prepare", forbidden)
+    monkeypatch.setattr(fleet.selection, "activate", forbidden)
+    monkeypatch.setattr(api, "_mint", forbidden)
+    with pytest.raises(api.HTTPException) as error:
+        asyncio.run(api.mobile_session(fleet.request))
+    assert error.value.status_code in {409, 503}
+    assert "secret" not in str(error.value.detail)
+
+
+@pytest.mark.parametrize("source", ["configured", "environment", None])
+def test_mobile_refuses_key_winner_or_missing_oauth_before_target_or_mint(
+    fleet, mobile_api, monkeypatch, source
+):
+    api, _ = mobile_api
+
+    def resolve(**kwargs):
+        return SimpleNamespace(token="sk-mobile-must-not-be-used", source=source)
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("A non-OAuth winner must not prepare, activate or mint")
+
+    if source is None:
+        monkeypatch.setattr(api.talk_auth, "_resolve_codex_oauth", lambda home: None)
+    else:
+        monkeypatch.setattr(api.talk_auth, "resolve_auth", resolve)
+    monkeypatch.setattr(fleet.selection, "prepare", forbidden)
+    monkeypatch.setattr(fleet.selection, "activate", forbidden)
+    monkeypatch.setattr(api, "_mint", forbidden)
+    with pytest.raises(api.HTTPException) as error:
+        asyncio.run(api.mobile_session(fleet.request))
+    assert error.value.status_code in {409, 503}
+    assert "sk-mobile" not in str(error.value.detail)
+
+
+@pytest.mark.parametrize(
+    "task",
+    [
+        None,
+        {"session_id": "task-a", "tab_id": "mobile-tab"},
+        {"target_id": "target"},
+        {"target_id": "target", "tab_id": "mobile-tab", "profile": "default"},
+        {"target_id": "", "tab_id": "mobile-tab"},
+    ],
+)
+def test_mobile_accepts_only_target_selection_task(fleet, mobile_api, monkeypatch, task):
+    api, body = mobile_api
+    body["task"] = task
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("Invalid mobile task must not join, prepare or mint")
+
+    monkeypatch.setattr(fleet.manager, "join", forbidden)
+    monkeypatch.setattr(fleet.selection, "prepare", forbidden)
+    monkeypatch.setattr(api, "_mint", forbidden)
