<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Glyph is drawn in a 28..102 x 7..86 box and scaled to 0.6 around
         (63,50), then moved to the canvas centre so it stays inside the
         66dp adaptive-icon safe zone on every launcher mask. -->
