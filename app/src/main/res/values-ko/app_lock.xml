<resources>
    <string name="app_lock_title">앱 잠금</string>
    <string name="app_lock_prompt">계속하려면 본인 인증을 해 주세요</string>
    <string name="app_lock_locked">Hermes가 잠겼습니다. 현재 화면과 보내지 않은 내용은 유지됩니다.</string>
    <string name="app_lock_unlock">잠금 해제</string>
    <string name="app_lock_unavailable">기기 PIN, 패턴 또는 비밀번호가 필요합니다. 기기 보안을 복원한 후 Hermes 잠금을 해제하세요.</string>
    <string name="app_lock_security_settings">Android 보안 설정 열기</string>
