+        asyncio.run(api.mobile_session(fleet.request))
+    assert error.value.status_code == 400
+
+
+def test_mobile_codex_mint_is_bound_and_freezes_model_and_auth(
+    fleet, mobile_api, monkeypatch
+):
+    api, body = mobile_api
+    prepare = fleet.selection.prepare
+    minted = []
+
+    def changing_config(*args, **kwargs):
+        prepared = prepare(*args, **kwargs)
+        # A configuration edit after preflight cannot change this request's biller/model.
+        monkeypatch.setenv("TALK_MODEL", "gpt-realtime")
+        monkeypatch.setenv("TALK_PREFER_CODEX_OAUTH", "false")
+        monkeypatch.setenv("TALK_VOICE_MODE", "cascade")
+        return prepared
+
+    def post(auth_token, session):
+        minted.append((auth_token, session))
+        return {"value": "ek_mobile_fixture", "expires_at": 1_700_000_000}
+
+    monkeypatch.setattr(fleet.selection, "prepare", changing_config)
+    monkeypatch.setattr(api.talk_wire, "post_client_secret", post)
+    response = asyncio.run(api.mobile_session(fleet.request))
+    assert len(minted) == 1
+    token, session = minted[0]
+    assert token == "fixture-codex-secret"
+    assert session["model"] == response["model"] == "gpt-realtime-2.1"
+    assert response["authSource"] == "codex-oauth"
+    assert response["voiceMode"] == "native"
+    assert response["mobileRealtime"] == {
+        "protocol": 1, "model": "gpt-realtime-2.1", "authSource": "codex-oauth",
+    }
+    assert response["selection"]["target_id"] == body["task"]["target_id"]
+    assert response["task"]["tab_id"] == "mobile-tab"
+    context = {key: response["task"][key] for key in ("connection_id", "generation")}
+    assert fleet.manager.binding(fleet.request, context).connection_id == context["connection_id"]
+    assert session["tools"] and session["tool_choice"] == "auto"
+    assert "fixture-codex-secret" not in json.dumps(response)
+    assert "sk-mobile" not in json.dumps(response)
+
+    # The same changed config must fail on the next call, not reuse prior readiness.
+    with pytest.raises(api.HTTPException) as error:
+        asyncio.run(api.mobile_session(fleet.request))
+    assert error.value.status_code == 409
+    assert len(minted) == 1
