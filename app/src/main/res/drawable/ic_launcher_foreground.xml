        android:pivotX="63"
        android:pivotY="50"
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="-9"
        android:translateY="4">

        <!-- Colours follow the Default (Slate dark) theme:
             H = onBackground #DEE3E5, wing = primary #80D5D2. -->

        <!-- H: left pillar, right pillar, crossbar -->
        <path
            android:fillColor="#DEE3E5"
            android:pathData="M30,22 L46,22 Q48,22 48,24 L48,84 Q48,86 46,86 L30,86 Q28,86 28,84 L28,24 Q28,22 30,22 Z" />
        <path
            android:fillColor="#DEE3E5"
            android:pathData="M66,30 L80,30 Q82,30 82,32 L82,84 Q82,86 80,86 L66,86 Q64,86 64,84 L64,32 Q64,30 66,30 Z" />
        <path
            android:fillColor="#DEE3E5"
            android:pathData="M38,48 L72,48 Q74,48 74,50 L74,58 Q74,60 72,60 L38,60 Q36,60 36,58 L36,50 Q36,48 38,48 Z" />

        <!-- Wing: long feather + short feather off the right pillar -->
        <path
            android:fillColor="#80D5D2"
            android:pathData="M70,30 Q82,12 96,8 Q101,7 99,13 Q94,26 82,30 Z" />
        <path
            android:fillColor="#80D5D2"
            android:pathData="M84,34 Q93,26 101,25 Q104,25 102,29 Q97,35 84,38 Z" />
