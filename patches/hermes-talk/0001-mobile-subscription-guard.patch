+def test_mobile_status_preserves_readiness_and_advertises_protocol(monkeypatch):
+    monkeypatch.setenv("TALK_MODEL", "gpt-realtime-2.1")
+    monkeypatch.setenv("TALK_VOICE_MODE", "native")
+    ordinary = call(api.talk_status, FakeRequest())
+    mobile = call(api.mobile_status, FakeRequest())
+    assert mobile.pop("mobileRealtime") == {
+        "protocol": 1, "model": "gpt-realtime-2.1", "authSource": "codex-oauth",
+    }
+    assert mobile == ordinary
+    assert RAW_KEY not in serialized(mobile)
+
+
+@pytest.mark.parametrize("handler", [api.mobile_status, api.mobile_session])
+def test_mobile_routes_authenticate_before_any_body_or_provider_work(monkeypatch, handler):
+    monkeypatch.setenv(api.DASHBOARD_TOKEN_ENV, "mobile-route-token")
+    with pytest.raises(api.HTTPException) as error:
+        call(handler, FakeRequest(raise_json=True))
+    assert error.value.status_code == 401
+
